rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'you@gmail.com'   // <-- המייל שלך
                   && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
